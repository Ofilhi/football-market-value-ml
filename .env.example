# Copy this file to .env and fill in your own values.
# .env is ignored by git: never commit real keys.

# football-data.org API token (free plan: https://www.football-data.org/client/register)
FOOTBALL_DATA_API_KEY=your_football_data_api_key

# LLM provider, used for the scouting reports. Any OpenAI-compatible API works.
# Default: the free tier of the Google Gemini API (key: https://aistudio.google.com/apikey).
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Other providers (change the three LLM_ lines above):
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1       LLM_MODEL=<a model ending in :free>
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.2   (local, no account:
#               set LLM_API_KEY to any text, e.g. ollama)
