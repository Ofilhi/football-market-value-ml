# Copy this file to .env and fill in your own values.
# .env is ignored by git: never commit real keys.

# football-data.org API token (free plan: https://www.football-data.org/client/register)
FOOTBALL_DATA_API_KEY=your_football_data_api_key

# LLM provider (OpenAI-compatible gateway), used for the scouting reports
RESPAN_API_KEY=your_respan_api_key
LLM_BASE_URL=https://gateway.respan.ai/v1/
LLM_MODEL=gemini-4-carbon:free
